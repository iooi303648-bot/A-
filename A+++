<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>찾아가는 A+++ 디지털 직무연수</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- React & Babel -->
    <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap');
        
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: #f5f5f7;
            color: #1d1d1f;
            overflow: hidden;
        }

        .tracking-tight { letter-spacing: -0.022em; }
        .tracking-tighter { letter-spacing: -0.05em; }
        
        /* Slide Transition */
        .slide-enter { opacity: 0; transform: scale(0.99) translateY(10px); }
        .slide-active { opacity: 1; transform: scale(1) translateY(0); transition: all 0.7s cubic-bezier(0.23, 1, 0.32, 1); }
        
        /* Custom Scrollbar for hidden elements */
        ::-webkit-scrollbar { width: 0px; background: transparent; }

        .glass-nav {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
        }
    </style>
</head>
<body>
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useEffect } = React;

        // Reusable Icon Component for Lucide
        const Icon = ({ name, size = 24, className = "" }) => {
            return <i data-lucide={name} style={{ width: size, height: size }} className={className}></i>;
        };

        const App = () => {
            const [currentSlide, setCurrentSlide] = useState(0);
            const [isAnimating, setIsAnimating] = useState(false);

            const slides = [
                {
                    id: 'slide-1',
                    type: 'intro',
                    subtitle: '디지털 교육의 미래',
                    title: '찾아가는 A+++\n디지털 직무연수',
                    meta: '부산 SW AI 교육운영 지원단\n동일중앙초등학교 김형준'
                },
                {
                    id: 'slide-2',
                    type: 'section',
                    number: '01',
                    title: '캔바 AI',
                    description: '매직 액티비티'
                },
                {
                    id: 'slide-3',
                    type: 'feature-image',
                    title: '캔바 AI - 매직 액티비티',
                    content: [
                        '역사 연표 등 복잡한 자료의 시각화',
                        '매직 스위치를 통한 인터랙티브 학습지 변환',
                        '학생 개별 맞춤형 AI 보조 활동 생성'
                    ],
                    image: 'https://lh3.googleusercontent.com/d/12qvbfpiIxnTa4wpic73WOukonsDVQBfQ', 
                    tagline: '데이터를 살아있는 시각적 자료로 바꾸는 혁신'
                },
                {
                    id: 'slide-4',
                    type: 'section',
                    number: '02',
                    title: '바이브 코딩',
                    description: "창의성을 설계하다"
                },
                {
                    id: 'slide-5',
                    type: 'vibe-comparison',
                    title: '전통적 도구를 넘어서는 경험',
                    subtitle: '바이브 코딩만의 차별점',
                    items: [
                        { icon: 'zap', label: '상호작용', old: '정형화된 퀴즈', new: '양방향 상호작용', desc: '정해진 보기 중 선택하는 틀을 깨고 AI와 대화하며 답을 찾아갑니다.' },
                        { icon: 'database', label: '지능화', old: '닫힌 데이터셋', new: '실시간 AI 연동', desc: '단순 확인을 넘어 AI가 답변을 분석하고 맞춤 반응을 생성합니다.' },
                        { icon: 'compass', label: '학습 경험', old: '일방향 진행', new: '유연한 탐구 활동', desc: '학생의 관심도에 따라 학습 경로가 고정되지 않고 자유롭게 확장됩니다.' }
                    ]
                },
                {
                    id: 'slide-6',
                    type: 'game-examples',
                    title: '무엇이든 만드세요.',
                    items: [
                        { title: '음식 이상형 월드컵', image: 'https://lh3.googleusercontent.com/d/16t-yFNF10ovjWA224du46IHpH4qatC32', desc: '개념의 우선순위를 정하는 토론 및 의사결정 활동', icon: 'trophy' },
                        { title: '속담 이어 말하기', image: 'https://lh3.googleusercontent.com/d/1iYjjEsOKyRjimdTChs_Sw7r8gJ0xrzuZ', desc: '실시간 문장 완성 및 맥락 파악 학습 게임', icon: 'gamepad-2' }
                    ]
                },
                {
                    id: 'slide-7',
                    type: 'artifact-view',
                    title: '발전된 바이브 코딩.',
                    link: 'https://claude.ai/public/artifacts/2c9321c5-2b75-49c9-a3ac-e591939b46dc',
                    image: 'https://lh3.googleusercontent.com/d/1GrDT_juLgLZT6kVx-YU-bUPTpmLbG03h',
                    tagline: '인공지능 아티팩트로 구현한 고차원 논리 학습 애플리케이션'
                },
                {
                    id: 'slide-8',
                    type: 'section',
                    number: '03',
                    title: '맞춤형 AI',
                    description: '선생님을 위한 인공지능 비서'
                },
                {
                    id: 'slide-9',
                    type: 'ai-grid',
                    title: '나만의 AI 전략',
                    items: [
                        { icon: 'cpu', title: '제미나이 젬 (Gems)', text: '업무 자동화 및 구글 도구 연동으로 수업 준비 시간을 획기적으로 단축합니다.' },
                        { icon: 'wand-2', title: 'GPTs', text: '교육과정 데이터를 학습시켜 전문적인 상담 및 개별 피드백 봇을 구축합니다.' }
                    ]
                },
                {
                    id: 'slide-10',
                    type: 'gem-preview',
                    title: '나만의 AI 경험하기.',
                    subtitle: '교육 전용 비서',
                    link: 'https://gemini.google.com/gem/6c28297703c4',
                    desc: '코드 생성 및 교육 시뮬레이션 설계에 특화된 전용 젬 활용 사례입니다.'
                },
                {
                    id: 'slide-11',
                    type: 'outro',
                    title: '감사합니다.',
                    text: '디지털 교육의 미래, 함께 만들어갑니다.',
                    meta: '동일중앙초등학교 김형준\n부산 SW AI 교육운영 지원단'
                }
            ];

            const nextSlide = () => {
                if (currentSlide < slides.length - 1 && !isAnimating) {
                    setIsAnimating(true);
                    setCurrentSlide(prev => prev + 1);
                    setTimeout(() => setIsAnimating(false), 500);
                }
            };

            const prevSlide = () => {
                if (currentSlide > 0 && !isAnimating) {
                    setIsAnimating(true);
                    setCurrentSlide(prev => prev - 1);
                    setTimeout(() => setIsAnimating(false), 500);
                }
            };

            useEffect(() => {
                const handleKeyDown = (e) => {
                    if (e.key === 'ArrowRight' || e.key === ' ') nextSlide();
                    if (e.key === 'ArrowLeft') prevSlide();
                };
                window.addEventListener('keydown', handleKeyDown);
                lucide.createIcons(); // Initialize icons
                return () => window.removeEventListener('keydown', handleKeyDown);
            }, [currentSlide]);

            useEffect(() => {
                lucide.createIcons();
            }, [currentSlide, isAnimating]);

            return (
                <div className="min-h-screen flex flex-col tracking-tight">
                    {/* Top Bar */}
                    <nav className="h-[44px] bg-black flex items-center justify-between px-6 z-50">
                        <div className="text-white opacity-90 cursor-pointer">
                            <svg width="18" height="18" viewBox="0 0 18 18" fill="currentColor"><path d="M9 0c4.97 0 9 4.03 9 9s-4.03 9-9 9-9-4.03-9-9 4.03-9 9-9zm0 2c-3.866 0-7 3.134-7 7s3.134 7 7 7 7-3.134 7-7-3.134-7-7-7z"/></svg>
                        </div>
                        <div className="flex space-x-10 text-[11px] font-bold text-white/50 uppercase tracking-widest">
                            {['교육', '혁신', '디지털', '지원'].map(item => <span key={item} className="hover:text-white transition-colors cursor-pointer">{item}</span>)}
                        </div>
                        <div className="w-[18px]"></div>
                    </nav>

                    {/* Sub Nav */}
                    <nav className="h-[52px] glass-nav border-b border-black/5 flex items-center justify-between px-10 sticky top-0 z-40">
                        <h2 className="text-[19px] font-semibold">찾아가는 A+++ 디지털 직무연수</h2>
                        <button className="bg-[#0066cc] text-white text-[11px] px-4 py-1.5 rounded-full font-bold active:scale-95 transition-all">
                            발표 시작
                        </button>
                    </nav>

                    {/* Main Stage */}
                    <main className="flex-1 flex items-center justify-center p-4 lg:p-8 relative">
                        {/* Dots */}
                        <aside className="absolute left-6 top-1/2 -translate-y-1/2 hidden xl:flex flex-col space-y-2 z-30">
                            {slides.map((_, idx) => (
                                <button 
                                    key={idx}
                                    onClick={() => setCurrentSlide(idx)}
                                    className={`w-1 h-1 rounded-full transition-all duration-500 ${currentSlide === idx ? 'h-6 bg-[#0066cc]' : 'bg-black/10 hover:bg-black/30'}`}
                                />
                            ))}
                        </aside>

                        {/* Canvas */}
                        <div className="relative w-full max-w-[1200px] aspect-video bg-white rounded-[40px] shadow-[0_40px_120px_-20px_rgba(0,0,0,0.08)] overflow-hidden border border-black/[0.02]">
                            <div className={`w-full h-full p-12 lg:p-16 flex flex-col transition-all duration-700 ${isAnimating ? 'opacity-0 scale-[0.99] blur-md' : 'opacity-100 scale-100 blur-0'}`}>
                                
                                {slides[currentSlide].type === 'intro' && (
                                    <div className="h-full flex flex-col justify-center space-y-6">
                                        <p className="text-[#0066cc] text-xl font-bold uppercase tracking-widest">{slides[currentSlide].subtitle}</p>
                                        <h1 className="text-[80px] lg:text-[100px] font-bold tracking-tighter leading-[0.9] whitespace-pre-line">{slides[currentSlide].title}</h1>
                                        <div className="pt-12 text-[#86868b] text-xl font-medium leading-relaxed opacity-80 whitespace-pre-line">{slides[currentSlide].meta}</div>
                                    </div>
                                )}

                                {slides[currentSlide].type === 'section' && (
                                    <div className="h-full flex flex-col justify-center text-center space-y-4">
                                        <div className="text-[#0066cc] text-[160px] font-bold opacity-[0.03] absolute left-1/2 -translate-x-1/2 top-1/2 -translate-y-1/2 scale-150 pointer-events-none tracking-tighter w-full">{slides[currentSlide].number}</div>
                                        <h2 className="text-7xl lg:text-9xl font-bold tracking-tight z-10">{slides[currentSlide].title}</h2>
                                        <p className="text-[#86868b] text-2xl lg:text-3xl font-medium tracking-tight z-10">{slides[currentSlide].description}</p>
                                    </div>
                                )}

                                {slides[currentSlide].type === 'feature-image' && (
                                    <div className="grid grid-cols-5 gap-12 items-center h-full">
                                        <div className="col-span-2 space-y-10">
                                            <h2 className="text-4xl lg:text-5xl font-bold tracking-tight">{slides[currentSlide].title}</h2>
                                            <ul className="space-y-6">
                                                {slides[currentSlide].content.map((item, i) => (
                                                    <li key={i} className="flex items-start gap-4 text-xl text-[#86868b] font-medium leading-tight" style={{wordBreak: 'keep-all'}}>
                                                        <div className="mt-2 w-1.5 h-1.5 rounded-full bg-[#0066cc] shrink-0" />
                                                        {item}
                                                    </li>
                                                ))}
                                            </ul>
                                        </div>
                                        <div className="col-span-3 flex flex-col items-center justify-center">
                                            <div className="w-full rounded-[32px] overflow-hidden shadow-2xl border border-black/5 bg-[#f5f5f7] flex items-center justify-center">
                                                <img src={slides[currentSlide].image} className="w-full h-auto max-h-[420px] object-contain" />
                                            </div>
                                            <p className="mt-6 text-[#86868b] text-[10px] font-bold tracking-[0.3em] uppercase">{slides[currentSlide].tagline}</p>
                                        </div>
                                    </div>
                                )}

                                {slides[currentSlide].type === 'vibe-comparison' && (
                                    <div className="h-full flex flex-col">
                                        <div className="mb-8 space-y-1">
                                            <h3 className="text-[#0066cc] text-lg font-bold uppercase tracking-widest">{slides[currentSlide].subtitle}</h3>
                                            <h2 className="text-5xl lg:text-6xl font-bold tracking-tighter">{slides[currentSlide].title}</h2>
                                        </div>
                                        <div className="grid grid-cols-3 gap-6 flex-1">
                                            {slides[currentSlide].items.map((item, i) => (
                                                <div key={i} className="bg-[#f5f5f7]/60 p-8 rounded-[24px] flex flex-col border border-black/[0.02] hover:bg-white hover:shadow-xl transition-all">
                                                    <div className="mb-6 p-2 bg-white rounded-xl w-fit shadow-sm"><Icon name={item.icon} className="text-[#0066cc]" size={20} /></div>
                                                    <div className="mb-4">
                                                        <p className="text-[#86868b] text-[10px] font-bold uppercase tracking-widest mb-1">{item.label}</p>
                                                        <h4 className="text-2xl font-bold tracking-tight">{item.new}</h4>
                                                    </div>
                                                    <div className="mt-auto pt-6 border-t border-black/5">
                                                        <div className="text-xs text-[#86868b] opacity-40 font-bold mb-2 flex items-center gap-2"><span className="w-3 h-px bg-current" />기존: {item.old}</div>
                                                        <p className="text-sm text-[#86868b] leading-snug font-medium" style={{wordBreak: 'keep-all'}}>{item.desc}</p>
                                                    </div>
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                )}

                                {slides[currentSlide].type === 'game-examples' && (
                                    <div className="space-y-12 h-full flex flex-col justify-center">
                                        <h2 className="text-5xl lg:text-6xl font-bold tracking-tight">{slides[currentSlide].title}</h2>
                                        <div className="grid grid-cols-2 gap-8 lg:gap-12">
                                            {slides[currentSlide].items.map((item, i) => (
                                                <div key={i} className="group flex flex-col">
                                                    <div className="rounded-[32px] overflow-hidden shadow-lg border border-black/5 aspect-video bg-[#f5f5f7] mb-6 flex items-center justify-center">
                                                        <img src={item.image} className="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
                                                    </div>
                                                    <div className="flex items-center gap-3 mb-2">
                                                        <div className="w-8 h-8 rounded-lg bg-[#f5f5f7] flex items-center justify-center shadow-sm"><Icon name={item.icon} className="text-[#0066cc]" size={20} /></div>
                                                        <h3 className="text-2xl font-bold tracking-tight">{item.title}</h3>
                                                    </div>
                                                    <p className="text-[#86868b] text-lg font-medium leading-snug" style={{wordBreak: 'keep-all'}}>{item.desc}</p>
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                )}

                                {slides[currentSlide].type === 'artifact-view' && (
                                    <div className="grid grid-cols-2 gap-12 items-center h-full">
                                        <div className="space-y-8">
                                            <div className="inline-flex items-center gap-2 bg-[#f5f5f7] px-4 py-2 rounded-full text-[#0066cc] font-bold text-xs uppercase tracking-wider">
                                                <Icon name="brain-circuit" size={16} /> 즉각적인 개발
                                            </div>
                                            <h2 className="text-6xl lg:text-7xl font-bold tracking-tighter leading-none">{slides[currentSlide].title}</h2>
                                            <p className="text-xl lg:text-2xl text-[#86868b] leading-tight font-medium" style={{wordBreak: 'keep-all'}}>가우스의 은화 수수께끼와 같은 복합적인 논리 활동도 인공지능을 통해 맞춤형 앱으로 즉각 구현됩니다.</p>
                                            <a href={slides[currentSlide].link} target="_blank" className="inline-flex items-center gap-2 text-[#0066cc] font-bold hover:underline text-lg">아티팩트 실행하기 <Icon name="external-link" size={18} /></a>
                                        </div>
                                        <div className="rounded-[32px] overflow-hidden shadow-2xl bg-white border border-black/5 p-8 flex items-center justify-center">
                                            <img src={slides[currentSlide].image} className="w-full h-auto max-h-[440px] object-contain" />
                                        </div>
                                    </div>
                                )}

                                {slides[currentSlide].type === 'ai-grid' && (
                                    <div className="h-full flex flex-col justify-center space-y-12">
                                        <h2 className="text-6xl font-bold tracking-tight text-center">{slides[currentSlide].title}</h2>
                                        <div className="grid grid-cols-2 gap-8 max-w-5xl mx-auto w-full">
                                            {slides[currentSlide].items.map((item, i) => (
                                                <div key={i} className="bg-[#f5f5f7]/80 backdrop-blur p-12 rounded-[32px] text-center space-y-8 border border-black/[0.01] hover:bg-white transition-all">
                                                    <div className="w-16 h-16 bg-white rounded-2xl shadow-sm flex items-center justify-center mx-auto text-[#0066cc]"><Icon name={item.icon} size={32} /></div>
                                                    <div className="space-y-4">
                                                        <h3 className="text-3xl font-bold tracking-tight">{item.title}</h3>
                                                        <p className="text-[#86868b] text-lg font-medium leading-relaxed" style={{wordBreak: 'keep-all'}}>{item.text}</p>
                                                    </div>
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                )}

                                {slides[currentSlide].type === 'gem-preview' && (
                                    <div className="h-full flex flex-col justify-center items-center text-center space-y-12">
                                        <div className="w-20 h-20 bg-gradient-to-br from-[#0066cc] to-[#55aaff] rounded-3xl flex items-center justify-center text-white shadow-xl animate-pulse">
                                            <Icon name="sparkles" size={40} />
                                        </div>
                                        <div className="space-y-4">
                                            <h3 className="text-[#0066cc] text-lg font-bold uppercase tracking-[0.3em] opacity-80">맞춤형 교육 인공지능</h3>
                                            <h2 className="text-6xl lg:text-8xl font-bold tracking-tighter">{slides[currentSlide].title}</h2>
                                        </div>
                                        <p className="text-2xl text-[#86868b] max-w-2xl mx-auto font-medium leading-snug" style={{wordBreak: 'keep-all'}}>{slides[currentSlide].desc}</p>
                                        <a href={slides[currentSlide].link} target="_blank" className="bg-[#1d1d1f] text-white px-10 py-4 rounded-full text-lg font-bold active:scale-95 transition-all shadow-xl hover:bg-black">제미나이 젬 실행하기</a>
                                    </div>
                                )}

                                {slides[currentSlide].type === 'outro' && (
                                    <div className="h-full flex flex-col justify-center text-center space-y-12">
                                        <h1 className="text-[100px] lg:text-[140px] font-bold tracking-tighter text-[#1d1d1f] leading-none">{slides[currentSlide].title}</h1>
                                        <div className="space-y-2">
                                            <p className="text-3xl text-[#0066cc] font-bold tracking-tight">{slides[currentSlide].text}</p>
                                            <p className="text-[#86868b] text-lg lg:text-xl font-medium pt-8 whitespace-pre-line leading-relaxed opacity-60">{slides[currentSlide].meta}</p>
                                        </div>
                                    </div>
                                )}

                            </div>

                            {/* Nav Controls */}
                            <div className="absolute bottom-6 right-8 flex items-center gap-2">
                                <button onClick={prevSlide} disabled={currentSlide === 0} className="p-2.5 rounded-full bg-black/5 hover:bg-black/10 disabled:opacity-0 transition-all active:scale-90">
                                    <Icon name="chevron-left" size={16} />
                                </button>
                                <div className="text-[9px] font-bold text-black/15 tracking-widest px-1">
                                    {String(currentSlide + 1).padStart(2, '0')} / {String(slides.length).padStart(2, '0')}
                                </div>
                                <button onClick={nextSlide} disabled={currentSlide === slides.length - 1} className="p-2.5 rounded-full bg-black/5 hover:bg-black/10 disabled:opacity-0 transition-all active:scale-90">
                                    <Icon name="chevron-right" size={16} />
                                </button>
                            </div>
                        </div>
                    </main>

                    {/* Footer */}
                    <footer className="h-10 flex items-center justify-center px-10 text-[10px] text-[#86868b] font-bold tracking-widest uppercase opacity-30">
                        <span>부산 SW AI 교육운영 지원단 • 2026</span>
                    </footer>
                </div>
            );
        };

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
